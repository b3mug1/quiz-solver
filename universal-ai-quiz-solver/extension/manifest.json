{
  "manifest_version": 3,
  "name": "Universal AI Quiz Solver",
  "version": "0.3.0",
  "description": "Suggested answers for authorized practice quizzes.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://universal-ai-quiz-solver.vercel.app/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background/service-worker.js"},
  "action": {"default_popup": "popup/popup.html"},
  "options_page": "options/options.html"
}
